# =============================================================================
# Kids Learning App — environment template
# Copy to `.env.local` and fill secrets. Never commit `.env.local`.
# =============================================================================

# --- Supabase (required for auth, profiles, progress, admin, media uploads) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role: uploads + promote-admin script only (server/scripts — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Public media: phonics → bucket `phonics`, toddler stories → bucket `story-animations`
# (paths are built from NEXT_PUBLIC_SUPABASE_URL in utils/supabaseMedia.ts)

# --- App / brand ---
NEXT_PUBLIC_APP_URL=https://kids.growvabusiness.com
ADMIN_EMAILS=maria.umeed1987@gmail.com
# Optional public mirror of admin list (prefer ADMIN_EMAILS for server)
# NEXT_PUBLIC_ADMIN_EMAILS=maria.umeed1987@gmail.com
# Extra passphrase gate on /admin after is_admin (leave empty to skip PIN modal)
ADMIN_DASHBOARD_PIN=

# --- Membership / testing ---
# true = unlock all paid features + hide ads (local QA). Set false for production gating.
NEXT_PUBLIC_OPEN_ACCESS_TEST_MODE=true

# --- Parent shop / contact / WhatsApp ---
NEXT_PUBLIC_PARENT_EMAIL_GROUP=mailto:support@growvabusiness.com?subject=Join%20Parent%20Email%20Group
# Digits only with country code, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_ORDER_PHONE=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/

# --- Brand ads: managed in /admin → Brand Ads (Supabase table brand_ads). No AdSense. ---

# --- School CRM webhook (Prompt L) ---
CRM_WEBHOOK_SECRET=

# --- Gemini image generation (colouring sheets) ---
# Google AI Studio key — use GEMINI_API_KEY=... (not "Gemini API =")
GEMINI_API_KEY=

# --- Optional: ElevenLabs for offline narration scripts ---
ELEVENLABS_API_KEY=

